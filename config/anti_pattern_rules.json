{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"version": "1.0.0",
	"policy_name": "Coding Agent Anti-Pattern Interception Rules",
	"codename": "DECISION-GATE-INTERCEPTOR",
	"created_at": "2026-09-22T23:15:00+09:00",
	"laya_daemon_url": "http://127.0.0.1:9876",
	"intervention_log_path": "${PI_ROUTER_HOME}/interventions.jsonl",
	"rules": {
		"skill_generation_interception": {
			"enabled": true,
			"description": "Apply configured path rules; token and cost savings are unmeasured",
			"target_tools": ["write_to_file", "replace_file_content"],
			"file_path_patterns": [
				"(?:^|/)skills/.*\\.skill\\.md$",
				"(?:^|/)skills/.*/SKILL\\.md$",
				".*_classifier\\.py$",
				".*_parser\\.py$",
				"(?:^|/)temp_.*\\.py$",
				".*_triage\\.py$",
				".*classify.*\\.sh$"
			],
			"action": "INTERCEPT_AND_OVERRIDE"
		},
		"error_loop_short_circuit": {
			"enabled": true,
			"description": "Classify matching command failures with local keyword rules; resolution is not measured",
			"target_tools": ["run_command"],
			"consecutive_failure_threshold": 1,
			"error_signatures": {
				"syntax_compile": {
					"patterns": [
						"TS[0-9]{4}",
						"SyntaxError",
						"TypeError",
						"unresolved import"
					],
					"prescribed_action": "Fix specific syntax/type violation directly without architectural reasoning or refactoring."
				},
				"dependency_missing": {
					"patterns": [
						"ModuleNotFoundError",
						"Cannot find module",
						"ENOENT",
						"No such package"
					],
					"prescribed_action": "Install missing package immediately via package manager. Do not modify source code."
				},
				"lint_formatting": {
					"patterns": [
						"Biome format check failed",
						"Ruff formatting",
						"ESLint rule violation"
					],
					"prescribed_action": "Run automated format-fix command directly (`npx @biomejs/biome check --write` or `ruff format`)."
				},
				"permission_auth": {
					"patterns": [
						"Permission denied",
						"EACCES",
						"401 Unauthorized",
						"403 Forbidden"
					],
					"prescribed_action": "Requires human operator privilege or secret credential. Halt autonomous retry loop immediately."
				}
			},
			"action": "INJECT_PRESCRIPTION"
		},
		"telemetry_progress_trigger": {
			"enabled": true,
			"description": "Manual CLI milestone report; no project lifecycle trigger is wired",
			"trigger_percentage": 75,
			"target_script": "scripts/hybrid-router-cli.py",
			"target_command": "savings",
			"action": "DISPLAY_MANUAL_TELEMETRY",
			"milestone_stages": [
				{ "stage": 1, "name": "Pre-flight Resource Audit", "weight": 25 },
				{
					"stage": 2,
					"name": "Core Pipeline Setup & Hierarchical Build",
					"weight": 25
				},
				{ "stage": 3, "name": "Verification & Integration", "weight": 25 },
				{ "stage": 4, "name": "Final Turn Report & Governance", "weight": 25 }
			]
		}
	}
}

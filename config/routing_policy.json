{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"version": "1.0.0",
	"policy_name": "Hybrid Decision Engine Routing Policy",
	"codename": "HYBRID-ROUTER (LAURA-PIPELINE)",
	"created_at": "2026-09-22T22:15:00+09:00",
	"routes": {
		"laya_route": {
			"description": "Local keyword heuristic; no model inference or latency guarantee",
			"engine": "keyword-heuristic-hierarchical",
			"conditions": {
				"max_tokens": 192,
				"max_latency_ms": 40,
				"max_choices_budget": 20,
				"supported_decision_types": ["choice", "score", "noul"],
				"target_task_classes": [
					"build_error_branching",
					"spam_filtering",
					"github_pr_assignment",
					"issue_component_tagging",
					"binary_triage"
				]
			},
			"hierarchical_strategy": {
				"tier1": "core_domain_filter",
				"tier2": "domain_specific_resolver"
			}
		},
		"jev_route": {
			"description": "Simulated keyword-overlap path; no external API request is made",
			"engine": "simulated-jev-keyword-match",
			"conditions": {
				"min_categories": 21,
				"task_types": [
					"high_dimension_categorization",
					"zero_shot_unclassified_issues",
					"complex_context_arbitration",
					"dynamic_ontology_mapping"
				]
			},
			"circuit_breaker": {
				"enabled": true,
				"failure_threshold": 3,
				"latency_ceiling_ms": 400,
				"recovery_timeout_sec": 30,
				"fallback_target": "laya_hierarchical_engine"
			}
		}
	},
	"rule_evaluation_order": [
		{
			"priority": 1,
			"condition": "categories_count > 20",
			"destination": "jev_route",
			"reason": "Exceeds the configured category threshold"
		},
		{
			"priority": 2,
			"condition": "latency_strict <= 40ms or tokens_count <= 192",
			"destination": "laya_route",
			"reason": "Matches a configured local route constraint; this is not a latency guarantee"
		},
		{
			"priority": 3,
			"condition": "task_type in ['build_error_branching', 'github_pr_assignment', 'issue_component_tagging']",
			"destination": "laya_route",
			"reason": "Task type is listed for local heuristic handling"
		},
		{
			"priority": 4,
			"condition": "default",
			"destination": "laya_route",
			"reason": "Configured local heuristic default"
		}
	]
}
